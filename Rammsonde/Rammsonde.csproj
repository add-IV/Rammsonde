<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <UseWindowsForms>True</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>Rammsonde</AssemblyName>
    <ApplicationIcon>mu.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>


  <Target Name="RemoveUnusedPublishFiles" AfterTargets="Publish">
    <ItemGroup>
      <UnusedPublishFiles Include="$(PublishDir)PdfSharp.BarCodes.dll" />
      <UnusedPublishFiles Include="$(PublishDir)PdfSharp.Charting.dll" />
      <UnusedPublishFiles Include="$(PublishDir)PdfSharp.Cryptography.dll" />
      <UnusedPublishFiles Include="$(PublishDir)PdfSharp.Quality.dll" />
      <UnusedPublishFiles Include="$(PublishDir)PdfSharp.Snippets.dll" />
      <UnusedPublishFiles Include="$(PublishDir)PdfSharp.WPFonts.dll" />
      <UnusedPublishFiles Include="$(PublishDir)$(AssemblyName).pdb" />
    </ItemGroup>
    <Delete Files="@(UnusedPublishFiles)" />
  </Target>

</Project>
